#include <iostream>
using namespace std;

// Greedy Coin Change
int main() {

    int coins[] = {100, 50, 20, 10, 5, 2, 1};

    int n = 7;

    int amount;

    cout << "Enter amount: ";
    cin >> amount;

    cout << "Coins used:" << endl;

    for (int i = 0; i < n; i++) {

        while (amount >= coins[i]) {

            amount -= coins[i];

            cout << coins[i] << " ";
        }
    }

    return 0;
}